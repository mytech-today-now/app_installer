# CLI-only container for app_installer.
# The Windows Forms GUI is not available in Linux containers.
FROM mcr.microsoft.com/dotnet/runtime:10.0-noble

ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive \
    POWERSHELL_TELEMETRY_OPTOUT=1 \
    TERM=xterm

RUN apt-get update \
    && apt-get install -y --no-install-recommends sudo ca-certificates curl coreutils libicu74 libssl3t64 tar \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    case "$TARGETARCH" in \
        amd64) asset='powershell-7.6.9-linux-x64.tar.gz'; sha256='1DA6D6D6035D651F20E70DDEE7C4C15AC6AB8B9FB40EE92240D91263F28A884B' ;; \
        arm64) asset='powershell-7.6.9-linux-arm64.tar.gz'; sha256='02EB9991AF447C7E7FE881ACDE195961AFD397C40B8EB1C2B3856B84EC2D85F2' ;; \
        *) echo "Unsupported container architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl --fail --show-error --location "https://github.com/PowerShell/PowerShell/releases/download/v7.6.9/$asset" --output /tmp/powershell.tar.gz; \
    printf '%s  %s\n' "$sha256" /tmp/powershell.tar.gz | sha256sum --check; \
    mkdir -p /opt/microsoft/powershell/7; \
    tar -xzf /tmp/powershell.tar.gz -C /opt/microsoft/powershell/7; \
    chmod +x /opt/microsoft/powershell/7/pwsh; \
    ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh; \
    rm -f /tmp/powershell.tar.gz

WORKDIR /opt/app-installer

COPY app-installer-cli.ps1 ./
COPY app-installer.ps1 ./
COPY platform-detect.ps1 ./
COPY apps-manifest.json ./
COPY modules ./modules
COPY apps ./apps
COPY profiles ./profiles

ENTRYPOINT ["pwsh", "-NoLogo", "-NoProfile", "-File", "/opt/app-installer/app-installer-cli.ps1"]
CMD ["-Action", "Status"]
